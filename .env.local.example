# Copy this file to .env.local for local development, and add the same
# three values in Vercel under Project Settings → Environment Variables
# for production.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → Project API keys → anon / public
# Safe to expose in the browser — read-only access to posts & notes only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → Project API keys → service_role
# SECRET — server-only. Never prefix this with NEXT_PUBLIC_. Used only by
# the /api/subscribe route to write new subscribers.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /admin/subscribers page (HTTP Basic Auth, checked in
# middleware.ts). Pick your own value — any username works, only the
# password is checked.
ADMIN_PASSWORD=
